<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <ScrollView
        android:id="@+id/quizScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_4"
            android:paddingTop="@dimen/space_6"
            android:paddingRight="@dimen/space_4"
            android:paddingBottom="@dimen/space_6">

            <TextView
                android:id="@+id/headerText"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:id="@+id/questionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/subjectChip"
                        style="@style/Text.Chip.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/pointText"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stemText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_stem"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/optionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/explanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@drawable/bg_note"
                    android:lineSpacingExtra="4dp"
                    android:padding="@dimen/space_4"
                    android:textColor="@color/note_ink"
                    android:textSize="@dimen/text_control"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/variantButton"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/quiz_variant"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 答对后的确认层：停一下再关，不然孩子只看到屏幕一闪，学不到"答对了才放行" -->
    <LinearLayout
        android:id="@+id/successLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_success_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle" />

        <TextView
            android:id="@+id/successTitle"
            style="@style/Text.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/quiz_success_title" />

        <TextView
            android:id="@+id/successBody"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/quiz_success_body" />
    </LinearLayout>
</FrameLayout>
