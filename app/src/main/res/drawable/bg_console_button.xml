<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_100" />
            <stroke android:width="1dp" android:color="@color/brand_300" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_sunken" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>
