<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_050" />
            <stroke android:width="2dp" android:color="@color/brand_300" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="2dp" android:color="@color/card_stroke" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
